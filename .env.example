# ==============================================================================
# RemoteMatch (BYN Architecture) — Controlled Beta Environment Configuration
# Copy this file to .env.local for local development or set in your Vercel/Netlify project settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required for production persistence)
# Schema migration files, in order: supabase/migrations/001_initial_schema.sql,
# 002_row_level_security.sql, 003_security_remediation.sql.
#
# Also required in the Supabase dashboard (cannot be set via env var):
#   Authentication -> Providers -> Anonymous Sign-Ins -> Enable
# (RemoteMatch has no login UI; every visitor gets a real, server-verifiable
#  anonymous session used to enforce quotas/entitlement — see
#  src/components/auth/auth-bootstrap.tsx.)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only. Bypasses Row Level Security — used exclusively by the Stripe
# webhook and the post-verification plan_tier write. NEVER prefix with
# NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Required for AI Resume Intelligence & Tailored Materials)
# Obtain from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. Stripe Payments (Required for Pro subscription checkout)
# Obtain from: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
# Required for /api/stripe/webhook signature verification (Stripe dashboard
# -> Developers -> Webhooks -> add endpoint for checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed -> copy the signing secret here). Without this set,
# a cancelled/failed subscription has no path to downgrade plan_tier.
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 3b. IndexNow internal management API (src/app/api/seo/indexnow)
# Required in every deployment — there is no default; the route fails closed
# (401) without it. Generate a long random value, do not reuse across envs.
# ------------------------------------------------------------------------------
INDEXNOW_SECRET=

# ------------------------------------------------------------------------------
# 4. App URL (Canonical domain for redirect URLs & webhooks)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
